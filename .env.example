# Server identity (used as notification prefix)
SERVER_NAME="My Server"

# Notification provider — "gotify" or "slack"
NOTIFY_PROVIDER=gotify

# --- Gotify settings (used when NOTIFY_PROVIDER=gotify) ---
GOTIFY_URL=https://gotify.example.com
GOTIFY_TOKEN=your-app-token-here

# --- Slack settings (used when NOTIFY_PROVIDER=slack) ---
# Create an incoming webhook: https://api.slack.com/messaging/webhooks
# The URL looks like https://hooks.slack.com/services/<workspace>/<channel>/<token>
SLACK_WEBHOOK_URL=

# Daily summary sections (comma-separated)
# Core sections (always included): uptime, load, ram, swap, disk, ssh, alerts
# Optional sections (only shown if software is detected):
#   pm2, docker, systemd, nginx, caddy, postgres
SUMMARY_SECTIONS="uptime,load,ram,swap,disk,ssh,alerts"
